# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Postgres — Neon connection string, e.g. postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Long random strings: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
ADMIN_JWT_SECRET=

# Created by `npm run db:migrate` if no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AI ────────────────────────────────────────────────────────────────────────
# Claude is used when ANTHROPIC_API_KEY is set; Groq is the fallback
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-sonnet-5)
ANTHROPIC_MODEL=
GROQ_API_KEY=
# Optional: override the Groq model (default openai/gpt-oss-120b)
GROQ_MODEL=

# ── Payments ──────────────────────────────────────────────────────────────────
# Without a Stripe key, exports are free in development only. In production they are
# unavailable unless ALLOW_FREE_EXPORTS=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_FREE_EXPORTS=

# ── Email ─────────────────────────────────────────────────────────────────────
# Resend is the primary sender (Render's free tier blocks SMTP). The sender must be on a
# domain verified in Resend, e.g. CVMaster <noreply@cvmaster.live>.
RESEND_API_KEY=
RESEND_FROM=CVMaster <noreply@cvmaster.live>
# Optional SMTP fallback (works locally; blocked on Render's free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Google sign-in ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── Frontend (build time) ─────────────────────────────────────────────────────
# Empty in local dev (Vite proxies /api to :3001); https://api.cvmaster.live in production
VITE_API_URL=
