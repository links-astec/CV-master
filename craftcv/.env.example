# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Postgres — Neon connection string, e.g. postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Long random strings: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
ADMIN_JWT_SECRET=

# Created by `npm run db:migrate` if no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AI ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Payments (leave empty for demo mode — exports are then free) ──────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email: SMTP is primary, Resend is the fallback ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=

# ── Google sign-in ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── Frontend (build time) ─────────────────────────────────────────────────────
# Empty in local dev (Vite proxies /api to :3001); https://api.cvmaster.live in production
VITE_API_URL=
