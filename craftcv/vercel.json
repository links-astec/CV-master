        {
          "type": "query",
          "key": "lang",
          "value": "es"
        }
      ],
      "destination": "/_seo/privacy.es.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "de"
        }
      ],
      "destination": "/_seo/privacy.de.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "it"
        }
      ],
      "destination": "/_seo/privacy.it.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "query",
