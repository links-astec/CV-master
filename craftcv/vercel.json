{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_URL": "https://api.cvmaster.live"
  },
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://api.cvmaster.live/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://api.cvmaster.live/blog/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "fr"
        }
      ],
      "destination": "/_seo/home.fr.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "es"
        }
      ],
      "destination": "/_seo/home.es.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "de"
        }
      ],
      "destination": "/_seo/home.de.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "it"
        }
      ],
      "destination": "/_seo/home.it.html"
    },
    {
