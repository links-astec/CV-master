        {
          "type": "query",
          "key": "lang",
          "value": "zh"
        }
      ],
      "destination": "/_seo/templates.zh.html"
    },
    {
      "source": "/templates",
      "destination": "/_seo/templates.en.html"
    },
    {
      "source": "/pricing",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "fr"
        }
