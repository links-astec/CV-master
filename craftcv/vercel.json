        {
          "type": "query",
          "key": "lang",
          "value": "zh"
        }
      ],
      "destination": "/_seo/home.zh.html"
    },
    {
      "source": "/",
      "destination": "/_seo/home.en.html"
    },
    {
      "source": "/templates",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "fr"
        }
      ],
      "destination": "/_seo/templates.fr.html"
    },
    {
      "source": "/templates",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "es"
        }
      ],
      "destination": "/_seo/templates.es.html"
