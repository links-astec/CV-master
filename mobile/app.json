{
  "expo": {
    "name": "CVMaster",
    "slug": "cvmaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cvmaster",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "live.cvmaster.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:www.cvmaster.live",
        "applinks:cvmaster.live"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4338CA",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "live.cvmaster.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.cvmaster.live",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "www.cvmaster.live",
              "path": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "cvmaster.live",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "cvmaster.live",
              "path": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0E0E16",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "CVMaster uses the photo you choose only as the picture on your CV.",
          "cameraPermission": false
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "CVMaster uses the microphone only while you record your career story, to turn your words into text."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4338CA",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
