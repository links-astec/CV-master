{
  "expo": {
    "name": "CVMaster",
    "slug": "cvmaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "cvmaster",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "live.cvmaster.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:www.cvmaster.live",
        "applinks:cvmaster.live"
      ],
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4338CA",
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "live.cvmaster.app",
      "allowBackup": false,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=live.cvmaster.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.cvmaster.live",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "www.cvmaster.live",
              "path": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "cvmaster.live",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "cvmaster.live",
              "path": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0C0C10",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "CVMaster uses the photo you choose only as the picture on your CV.",
          "cameraPermission": false
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "CVMaster uses the microphone only while you record your career story, to turn your words into text."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4338CA",
          "defaultChannel": "default"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "81eaefa1-6407-482c-9b68-3788584ee4ec"
      }
    },
    "owner": "gabbyquaye"
  }
}
